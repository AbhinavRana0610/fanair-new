# --------------------------------------------------------
# Only one Home / About / Contact page: send old copies,
# backups and test pages to the real page (301), and hide
# PHP partials that would otherwise render as thin pages
# --------------------------------------------------------
<IfModule mod_alias.c>
  RedirectMatch 301 ^/fanairf?(/.*)?$ /
  RedirectMatch 301 ^/index-2\.php$ /
  RedirectMatch 301 ^/index_backup_old\.php$ /
  RedirectMatch 301 ^/temp_images\.php$ /
  RedirectMatch 301 ^/thumb_test\.php$ /
  RedirectMatch 301 ^/site-map-2\.php$ /site-map.php
  RedirectMatch 404 ^/includes/
  RedirectMatch 404 ^/(header|footer)\.php$
</IfModule>
